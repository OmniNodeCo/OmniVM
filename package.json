{
  "name": "omnivm",
  "version": "1.0.0",
  "description": "Run virtual machines on your desktop — bundled OmniOS guest, live console, snapshots. No hypervisor required.",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "omnivm": "bin/omnivm.js"
  },
  "scripts": {
    "start": "node bin/omnivm.js",
    "test": "node test/smoke.js",
    "build:guest": "make -C guests/omnios",
    "build": "node scripts/build.mjs"
  },
  "keywords": [
    "vm",
    "virtualization",
    "emulator",
    "x86",
    "terminal",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "v86": "0.5.462"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "build": {
    "appId": "dev.omninode.omnivm",
    "productName": "OmniVM",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "bin/**/*",
      "vendor/**/*",
      "guests/omnios/omnios.img",
      "package.json",
      "!test/**",
      "!scripts/**",
      "!release/**",
      "!dist/**"
    ],
    "linux": {
      "targets": [
        "AppImage",
        "deb"
      ],
      "category": "System",
      "executableName": "omnivm"
    },
    "mac": {
      "targets": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "targets": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": "false",
      "allowToChangeInstallationDirectory": "true"
    }
  },
  "author": "OmniVM contributors <omnivm@omninode.dev>"
}
